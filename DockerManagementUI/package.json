{
  "name": "DockerManagementUI",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate:api": "openapi-generator-cli generate",
    "generate:api:clean": "rimraf src/app/api && npm run generate:api",
    "postinstall": "npm run generate:api",
    "lint": "ng lint && npx stylelint '**/*.scss'"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@9.8.0",
  "dependencies": {
    "@angular/animations": "^21.2.7",
    "@angular/cdk": "^21.1.1",
    "@angular/common": "^21.2.7",
    "@angular/compiler": "^21.2.7",
    "@angular/core": "^21.2.7",
    "@angular/forms": "^21.2.7",
    "@angular/material": "^21.1.1",
    "@angular/platform-browser": "^21.2.7",
    "@angular/router": "^21.2.7",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "ngx-toastr": "^20.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.7",
    "@angular/cli": "^21.1.7",
    "@angular/compiler-cli": "^21.2.7",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.18.4",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^27.1.0",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "rimraf": "^6.1.2",
    "stylelint": "^17.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  }
}
